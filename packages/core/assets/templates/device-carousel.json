  "screens": 5,
  "brief": {
    "preset": "1080p",
    "duration": 8,
    "style": "dark-studio",
    "devices": [
      {
        "model": "phone-modern",
        "screen": "{{screen1}}"
      },
      {
        "model": "phone-modern",
        "screen": "{{screen2}}"
      },
      {
        "model": "phone-modern",
        "screen": "{{screen3}}"
      },
      {
        "model": "phone-modern",
        "screen": "{{screen4}}"
      },
      {
        "model": "phone-modern",
        "screen": "{{screen5}}"
      }
