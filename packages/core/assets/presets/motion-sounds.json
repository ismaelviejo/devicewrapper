  "exit-left": [{ "cue": "swipe", "at": 0, "gain": 1.4 }],
  "exit-right": [{ "cue": "swipe", "at": 0, "gain": 1.4 }],
  "fade-in": [{ "cue": "open", "at": 0 }],
  "fade-out": [{ "cue": "close", "at": 0 }],
  "spin-reveal": [{ "cue": "swipe", "at": 0, "gain": 1.4 }],
  "tilt-up": [{ "cue": "swipe", "at": 0, "gain": 1.4 }],
  "lid-open": [{ "cue": "open", "at": 0.05 }],
