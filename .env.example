# Where devicewrapper keeps its files. Every value is optional.
# Env vars win over <workspace>/.devicewrapper/config.json, which wins over defaults.

# Workspace root: scenes, assets and outputs live under it. Default: the current directory.
DEVICEWRAPPER_WORKSPACE=.

# Data directory (scenes, jobs, previews). Default: <workspace>/.devicewrapper
# DEVICEWRAPPER_DATA_DIR=.devicewrapper

# Render output directory. Default: <data dir>/output
# DEVICEWRAPPER_OUTPUT_DIR=.devicewrapper/output

# Temporary render files. Default: <data dir>/tmp
# DEVICEWRAPPER_TMP_DIR=

# Extra folders the server may read assets from and write outputs to (comma separated).
# DEVICEWRAPPER_ALLOWED_ROOTS=

# FFmpeg / ffprobe binaries. Default: found on PATH.
# DEVICEWRAPPER_FFMPEG_PATH=ffmpeg
# DEVICEWRAPPER_FFPROBE_PATH=ffprobe

# Chromium executable. Default: the headless shell installed by `devicewrapper setup`.
# DEVICEWRAPPER_CHROMIUM_PATH=

# deterministic = CPU rendering (identical pixels on every machine, slower)
# fast          = GPU rendering when available (faster, may differ between machines)
DEVICEWRAPPER_RENDER_MODE=deterministic

DEVICEWRAPPER_MAX_CONCURRENT_RENDERS=2
DEVICEWRAPPER_MAX_RESOLUTION=7680x4320
DEVICEWRAPPER_MAX_DURATION_SECONDS=120
DEVICEWRAPPER_MAX_IMAGE_MB=100
DEVICEWRAPPER_MAX_VIDEO_MB=2048
